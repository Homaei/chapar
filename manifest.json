{
  "manifest_version": 3,
  "name": "Chapar - Bale to Telegram Notifier",
  "version": "1.0.0",
  "description": "Forwards Bale Web notifications to Telegram via Bot API. Supports status tracking and deep links.",
  "author": "hubert.homaei@gmail.com",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "*://web.bale.ai/*",
    "https://api.telegram.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Chapar Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://web.bale.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://web.bale.ai/*"]
    }
  ]
}
